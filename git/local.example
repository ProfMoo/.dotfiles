# Template for ignored git/local, which Dotbot symlinks to ~/.gitconfig.local.
#
# Purpose: all private Git config for this machine. This includes identity,
# signing keys, company URLs, tokens, proxies, and machine-specific tools/paths.
# The tracked git/config loads this file last, so values here override shared
# defaults.

# Machine defaults:
# [core]
#	editor = nvim

# Personal defaults for repos under ~/code/:
# [includeIf "gitdir:~/code/"]
#	path = ~/.gitconfig.personal

# Work overrides for repos under ~/work/ and ~/code/work/:
# [includeIf "gitdir:~/work/"]
#	path = ~/.gitconfig.work
# [includeIf "gitdir:~/code/work/"]
#	path = ~/.gitconfig.work

# Optional: keep identity inline here instead of separate include files.
# [user]
#	name = Your Name
#	email = you@example.com
#	signingKey = KEY_ID
